#!/usr/bin/env bash
# Start the sdkgen mock server the test-suite runs against (port 4010).
#
# The spec and generator config default to the monorepo layout; override with SDKGEN_SPEC,
# SDKGEN_CONFIG and SDKGEN_BIN.
set -e

cd "$(dirname "$0")/.."

SPEC="${SDKGEN_SPEC:-../../../automated/openapi.json}"
CONFIG="${SDKGEN_CONFIG:-../../../tools/sdkgen/config.yaml}"
SDKGEN="${SDKGEN_BIN:-}"
if [ -z "$SDKGEN" ]; then
  if command -v sdkgen >/dev/null 2>&1; then
    SDKGEN=sdkgen
  elif [ -f ../../../tools/sdkgen/Cargo.toml ]; then
    (cd ../../../tools/sdkgen && cargo build -q)
    SDKGEN=../../../tools/sdkgen/target/debug/sdkgen
  else
    echo "sdkgen not found; set SDKGEN_BIN" >&2
    exit 1
  fi
fi

echo "==> Starting mock server with spec ${SPEC}"

if [ "$1" == "--daemon" ]; then
  "$SDKGEN" mock --spec "$SPEC" --config "$CONFIG" --host 127.0.0.1 --port 4010 &> .mock.log &

  echo -n "Waiting for server"
  attempts=0
  while ! curl --silent --fail "http://127.0.0.1:4010/_sdkgen/health" >/dev/null 2>&1; do
    if ! kill -0 $! 2>/dev/null; then
      echo
      cat .mock.log
      exit 1
    fi
    attempts=$((attempts + 1))
    if [ "$attempts" -ge 100 ]; then
      echo
      echo "Timeout waiting for server"
      cat .mock.log
      exit 1
    fi
    echo -n "."
    sleep 0.1
  done
  echo
else
  exec "$SDKGEN" mock --spec "$SPEC" --config "$CONFIG" --host 127.0.0.1 --port 4010
fi
